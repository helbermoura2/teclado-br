# Export these variables in the shell before starting the server. No dotenv dependency.
PORT=3000
HOST=0.0.0.0
# Required when hosting for a phone/player; use the real HTTPS origin, no trailing slash.
PUBLIC_BASE_URL=https://your-cena-server.example
# Optional. Without this, search uses a clearly labelled small sample catalog.
TMDB_READ_TOKEN=
# Directory must be on persistent storage in production.
DATA_DIR=./data


# IA online: configure apenas no servidor, nunca no APK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Token de acesso ao seu servidor (diferente da chave Gemini).
CENA_AI_ACCESS_TOKEN=
